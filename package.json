{
  "name": "project-finance-platform",
  "version": "1.0.0",
  "description": "GraphQL API to manage projects, invitations, and project finances (Apollo Server + Prisma + MySQL)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "pretest": "docker exec finance_mysql mysql -uroot -proot -e \"CREATE DATABASE IF NOT EXISTS finance_test;\" && dotenv -e .env.test -- npx prisma migrate deploy",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest --runInBand"
  },
  "keywords": [
    "graphql",
    "apollo-server",
    "prisma",
    "mysql",
    "express",
    "typescript",
    "jwt"
  ],
  "author": "Narek Galstyan",
  "license": "ISC",
  "devDependencies": {
    "@swc/core": "^1.15.41",
    "@swc/jest": "^0.2.39",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.4.2",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "graphql": "^16.14.2",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3"
  }
}
